local JDSpikeAimbot = {}
do
    local _Enabled = false
    local _ActiveUntil = 0
    local _CooldownUntil = 0
    local _Target = nil
    local _HeartbeatConn = nil
    local _ButtonConnections = {}
    local _BoundButtons = setmetatable({}, { __mode = "k" })
    local LOCK_DURATION = 4
    local COOLDOWN_DURATION = 15
    local PREDICTION = 0.1768521

    local function _GetRoot(player)
        local char = player and player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not hum or hum.Health <= 0 then return nil end
        return root
    end

    local function _FindNearest()
        local myRoot = _GetRoot(LocalPlayer)
        if not myRoot then return nil end

        local best, bestDistance = nil, math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local root = _GetRoot(player)
                if root then
                    local distance = (root.Position - myRoot.Position).Magnitude
                    if distance < bestDistance then
                        best, bestDistance = player, distance
                    end
                end
            end
        end
        return best
    end

    local function _ClearTarget()
        if _Target and _Target.Character then
            for _, child in ipairs(_Target.Character:GetChildren()) do
                if child:IsA("Highlight") and child.Name == "JDSpikeHL" then
                    child:Destroy()
                end
            end
        end
        _Target = nil
    end

    local function _SetTarget(player)
        _ClearTarget()
        _Target = player
        local char = player and player.Character
        if not char then return end

        local hl = Instance.new("Highlight")
        hl.Name = "JDSpikeHL"
        hl.Adornee = char
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor = Color3.fromRGB(0, 0, 0)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = char
    end

    local function _StopAiming()
        if _HeartbeatConn then
            _HeartbeatConn:Disconnect()
            _HeartbeatConn = nil
        end
        _ClearTarget()
        _ActiveUntil = 0
    end

    local function _StartAiming()
        if not _Enabled then return end
        local target = _FindNearest()
        if not target then return end

        _SetTarget(target)
        _ActiveUntil = os.clock() + LOCK_DURATION

        if _HeartbeatConn then
            _HeartbeatConn:Disconnect()
            _HeartbeatConn = nil
        end

        _HeartbeatConn = RunService.Heartbeat:Connect(function()
            if not _Enabled or os.clock() >= _ActiveUntil then
                _StopAiming()
                return
            end

            local root = _GetRoot(_Target)
            if not root then
                local nextTarget = _FindNearest()
                if not nextTarget then
                    _StopAiming()
                    return
                end
                _SetTarget(nextTarget)
                root = _GetRoot(_Target)
                if not root then return end
            end

            local camera = workspace.CurrentCamera
            if camera then
                camera.CFrame = CFrame.new(
                    camera.CFrame.Position,
                    root.Position + root.AssemblyLinearVelocity * PREDICTION
                )
            end
        end)
    end

    local function _IsCorruptEnergyButton(button)
        if not button or not button:IsA("GuiButton") then return false end
        local parts = { button.Name }
        for _, item in ipairs(button:GetDescendants()) do
            if item:IsA("TextLabel") or item:IsA("TextButton") then
                table.insert(parts, item.Text or "")
            end
        end
        local label = table.concat(parts, " "):lower()
        label = label:gsub("[%s_%-]", "")
        return label:find("corruptenergy", 1, true) ~= nil
    end

    local function _BindAbilityButton(button)
        if _BoundButtons[button] or not _IsCorruptEnergyButton(button) then return end
        _BoundButtons[button] = true
        table.insert(_ButtonConnections, button.Activated:Connect(function()
            if not _Enabled then return end

            local now = os.clock()
            if now < _CooldownUntil then return end

            _CooldownUntil = now + COOLDOWN_DURATION
            _StartAiming()
        end))
    end

    local function _ScanAbilityButtons()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        local main = pg:FindFirstChild("MainUI")
        local container = main and main:FindFirstChild("AbilityContainer", true)
        if not container then return end

        for _, item in ipairs(container:GetDescendants()) do
            if item:IsA("GuiButton") then
                _BindAbilityButton(item)
            end
        end

        if not container:GetAttribute("JD_CorruptEnergyWatcher") then
            container:SetAttribute("JD_CorruptEnergyWatcher", true)
            container.DescendantAdded:Connect(function(item)
                if item:IsA("GuiButton") then
                    task.defer(_BindAbilityButton, item)
                elseif item:IsA("TextLabel") then
                    task.defer(function()
                        local parent = item.Parent
                        while parent and parent ~= container do
                            if parent:IsA("GuiButton") then
                                _BindAbilityButton(parent)
                                break
                            end
                            parent = parent.Parent
                        end
                    end)
                end
            end)
        end
    end

    function JDSpikeAimbot.SetEnabled(value)
        _Enabled = value == true
        if not _Enabled then
            _StopAiming()
        else
            _ScanAbilityButtons()
        end
    end

    local function _WatchMainUI(main)
        if not main or main:GetAttribute("JD_CorruptEnergyMainWatcher") then return end
        main:SetAttribute("JD_CorruptEnergyMainWatcher", true)
        main.DescendantAdded:Connect(function(item)
            if item.Name == "AbilityContainer" then
                task.defer(_ScanAbilityButtons)
            elseif item:IsA("GuiButton") or item:IsA("TextLabel") then
                task.defer(function()
                    local container = main:FindFirstChild("AbilityContainer", true)
                    if container and item:IsDescendantOf(container) then
                        if item:IsA("GuiButton") then
                            _BindAbilityButton(item)
                        else
                            local parent = item.Parent
                            while parent and parent ~= container do
                                if parent:IsA("GuiButton") then
                                    _BindAbilityButton(parent)
                                    break
                                end
                                parent = parent.Parent
                            end
                        end
                    end
                end)
            end
        end)
        task.defer(_ScanAbilityButtons)
    end

    local function _WatchGui()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        local main = pg:FindFirstChild("MainUI")
        if main then _WatchMainUI(main) end
        pg.ChildAdded:Connect(function(child)
            if child.Name == "MainUI" then
                task.delay(0.25, function() _WatchMainUI(child) end)
            end
        end)
        task.defer(_ScanAbilityButtons)
    end

    _WatchGui()
    LocalPlayer.CharacterAdded:Connect(function()
        _StopAiming()
        task.delay(1, _ScanAbilityButtons)
    end)
end

