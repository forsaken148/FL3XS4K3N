    local function makeHitboxAndCheck(killerModel)
        if not killerModel or not killerModel.Parent then return end
        local char = LocalCharacter or LocalPlayer.Character
        if not char then return end

        local hbCfg = getKillerHitbox(killerModel.Name)
        local multiplier = NS_AB.HitboxMultiplier or 1
        local hbWidth  = hbCfg.width  or NS_AB.HitboxWidth
        local hbLength = hbCfg.length or NS_AB.HitboxLength
        local hbHeight = hbCfg.height or NS_AB.HitboxHeight
        local showVisual   = NS_AB.ShowHitboxVisual
        local distance     = hbCfg.distance or NS_AB.HitboxDistance or 3
        local color        = NS_AB.HitboxColor
        local transparency = NS_AB.HitboxTransparency
        if JHB.Enabled then
            hbWidth, hbHeight, hbLength = JHB.Width, JHB.Height, JHB.Depth
            showVisual, distance = JHB.ShowVisual, JHB.Distance
            color, transparency = JHB.Color, JHB.Transparency
        end
        local size = Vector3.new(hbWidth * multiplier, hbHeight * multiplier, hbLength * multiplier)

        local overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Include
        overlap.FilterDescendantsInstances = { char }
        overlap.MaxParts = 1
        local hum = char:FindFirstChildOfClass("Humanoid")

        local visual, outline
        local function makeVisual(cf)
            if visual or not showVisual then return end
            visual = Instance.new("Part")
            visual.Name = "AutoBlockHitbox_Visual"
            visual.Anchored = true
            visual.CanCollide = false
            visual.CanTouch = false
            visual.CanQuery = false
            visual.CastShadow = false
            visual.Material = Enum.Material.ForceField
            visual.Size = size
            visual.Color = color
            visual.Transparency = transparency
            visual.CFrame = cf
            visual.Parent = HitboxFolder
            if NS_AB.ShowOutline then
                outline = Instance.new("SelectionBox")
                outline.Adornee = visual
                outline.Color3 = color
                outline.LineThickness = NS_AB.OutlineThickness
                outline.Transparency = NS_AB.OutlineTransparencyValue or 0.6
                outline.Visible = true
                outline.Parent = visual
            end
        end

        local function probe()
            if not killerModel.Parent then return nil end
            local root = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
            if not root then return nil end
            local cf = root.CFrame * CFrame.new(0, 0, -distance)
            if visual then visual.CFrame = cf end
            local hit = #workspace:GetPartBoundsInBox(cf, size, overlap) > 0 and (not hum or hum.Health > 0)
            return hit, cf
        end

        local function block()
            local delayMs = tonumber(State.BlockDelay) or 0
            if delayMs > 0 then
                task.delay(delayMs / 1000, function() if State.AutoBlock then fireBlockNS() end end)
            else
                fireBlockNS()
            end
        end

        local hit, cf = probe()
        if hit then
            block()
            if showVisual then
                makeVisual(cf)
                if visual then
                    visual.Color = NS_AB.HitboxHitColor
                    if outline then outline.Color3 = NS_AB.HitboxHitColor end
                    task.delay(0.15, function() pcall(function() visual:Destroy() end) end)
                end
            end
            return
        end
        if hit == nil then return end

        local window = math.max(hbCfg.dura or 0.01, 0.034)
        task.spawn(function()
            local startedAt = os.clock()
            if showVisual then makeVisual(cf) end
            while os.clock() - startedAt < window do
                if not State.AutoBlock or not killerModel.Parent then break end
                RunService.PreSimulation:Wait()
                local h = probe()
                if h then
                    block()
                    if visual then
                        visual.Color = NS_AB.HitboxHitColor
                        if outline then outline.Color3 = NS_AB.HitboxHitColor end
                    end
                    break
                end
                if h == nil then break end
            end
            if visual then pcall(function() visual:Destroy() end) end
        end)
    end

