    local function makeHitboxAndCheck(killerModel, onDetected)
        if not killerModel or not killerModel.Parent then return end
        local killerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
        if not killerRoot then return end
        local hbCfg = getKillerHitbox(killerModel.Name)
        local m = NS_AB.HitboxMultiplier or 1
        local hbWidth = hbCfg.width or NS_AB.HitboxWidth
        local hbLength = hbCfg.length or NS_AB.HitboxLength
        local hbHeight = hbCfg.height or NS_AB.HitboxHeight
        -- UI JHB overrides when enabled
        if JHB.Enabled then
            hbWidth = JHB.Width
            hbHeight = JHB.Height
            hbLength = JHB.Depth
        end
        local size = Vector3.new(hbWidth*m, hbHeight*m, hbLength*m)
        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Exclude
        op.FilterDescendantsInstances = {killerModel}
        task.spawn(function()
            local startTime = tick()
            local blockedOnce = false
            local showVis = NS_AB.ShowHitboxVisual
            if JHB.Enabled then showVis = JHB.ShowVisual end
            local dist = hbCfg.distance or NS_AB.HitboxDistance or 3
            if JHB.Enabled then dist = JHB.Distance end
            local color = NS_AB.HitboxColor
            if JHB.Enabled then color = JHB.Color end
            local trans = NS_AB.HitboxTransparency
            if JHB.Enabled then trans = JHB.Transparency end
            while tick() - startTime < hbCfg.dura do
                if blockedOnce then break end
                if not State.AutoBlock then break end
                local ckr = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
                if not ckr then break end
                local frozenCFrame = ckr.CFrame * CFrame.new(0,0,-(dist))
                local hb = Instance.new("Part")
                hb.Name = "AutoBlockHitbox_Frame"
                hb.Transparency = showVis and trans or 1
                hb.CanCollide = false; hb.CanTouch = false; hb.CanQuery = false
                hb.CastShadow = false; hb.Anchored = true
                hb.Size = size; hb.Color = color
                hb.Material = (JHB.Enabled and JHB.GlowMode) and Enum.Material.ForceField or Enum.Material.ForceField
                hb.CFrame = frozenCFrame; hb.Parent = workspace
                local sb
                if NS_AB.ShowOutline and showVis then
                    sb = Instance.new("SelectionBox")
                    sb.Adornee = hb; sb.Color3 = color
                    sb.LineThickness = NS_AB.OutlineThickness
                    sb.Transparency = NS_AB.OutlineTransparencyValue or 0.6
                    sb.Visible = true; sb.Parent = hb
                end
                pcall(function() game:GetService("Debris"):AddItem(hb, hbCfg.life) end)
                local found = false
                for _, part in ipairs(workspace:GetPartsInPart(hb, op)) do
                    local char = part.Parent
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and Players:GetPlayerFromCharacter(char) == LocalPlayer then
                        found = true; break
                    end
                    if LocalCharacter and (part:IsDescendantOf(LocalCharacter) or char == LocalCharacter) then
                        found = true; break
                    end
                end
                if found and not blockedOnce then
                    blockedOnce = true
                    pcall(function()
                        hb.Color = NS_AB.HitboxHitColor
                        if sb then sb.Color3 = NS_AB.HitboxHitColor end
                    end)
                    fireBlockNS()
                    if onDetected then onDetected() end
                    break
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end

