    local title = opts.Title or "Flex Saken"
    local footer = opts.Footer or "v1.1 — Crimson"
    local size = opts.Size or UDim2.fromOffset(680, 460)
    local accent = opts.Accent or Theme.Accent
    Theme.Accent = accent; Theme.AccentHover = Color3.new(math.min(1,accent.R*1.15),math.min(1,accent.G*1.15),math.min(1,accent.B*1.15))
    Theme.SliderFill = accent; Theme.ToggleOn = accent
    local toggleKey = opts.ToggleKeybind or Enum.KeyCode.RightShift

    for _, name in ipairs({"KanhaUI","FlexSaken_UI","WindUI"}) do
        local old = CoreGui:FindFirstChild(name); if old then old:Destroy() end
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
