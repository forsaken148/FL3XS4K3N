    round(Main,12); stroke(Main,Theme.Border,1,0.3)

    local TitleBar = Instance.new("Frame"); TitleBar.Size = UDim2.new(1,0,0,42)
    TitleBar.BackgroundColor3 = Theme.Surface; TitleBar.BorderSizePixel = 0; TitleBar.Parent = Main; round(TitleBar,12)
    local TitleCover = Instance.new("Frame"); TitleCover.Size = UDim2.new(1,0,0,14); TitleCover.Position = UDim2.new(0,0,1,-14)
