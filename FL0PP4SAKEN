-- HITBOX COLOR SYSTEM (full implementation)
-- ============================================================
do
    local previousUnload = rawget(_G, "__HITBOX_COLOR_UNLOAD")
    if type(previousUnload) == "function" then
        pcall(previousUnload, "Replaced by new instance")
    end
end

local HC = {}
do
    local hcActive      = true
    local hcConnections = {}
    local hcTracked     = setmetatable({}, { __mode = "k" })

    local HC_COLOR_DB = {
        white      = { rgb = { 255, 255, 255 } },
        black      = { rgb = { 0,   0,   0   } },
        gray       = { rgb = { 128, 128, 128 } },
        silver     = { rgb = { 192, 192, 192 } },
        red        = { rgb = { 255, 0,   0   } },
        burgundy   = { rgb = { 128, 0,   32  } },
        orange     = { rgb = { 255, 122, 0   } },
        yellow     = { rgb = { 255, 238, 0   } },
        gold       = { rgb = { 255, 215, 0   } },
        green      = { rgb = { 0,   255, 0   } },
        lime       = { rgb = { 166, 255, 0   } },
        dark_green = { rgb = { 0,   122, 51  } },
        cyan       = { rgb = { 0,   255, 255 } },
        turquoise  = { rgb = { 26,  188, 156 } },
        blue       = { rgb = { 0,   102, 255 } },
        light_blue = { rgb = { 77,  195, 255 } },
        dark_blue  = { rgb = { 0,   43,  128 } },
        purple     = { rgb = { 138, 43,  226 } },
        lavender   = { rgb = { 200, 162, 200 } },
        pink       = { rgb = { 255, 77,  166 } },
        magenta    = { rgb = { 255, 0,   255 } },
    }

    local HC_ALIASES = {
        grey="gray", violet="purple", aqua="cyan",
        lightblue="light_blue", darkblue="dark_blue", darkgreen="dark_green",
    }

    local hcConfig = {
        USE_NEON              = false,
        CUSTOM_TRANSPARENCY   = nil,
        DETECT_RED_HITBOXES   = true,
    }

    local hcCurrentColor = Color3.fromRGB(255, 255, 255)
    local hcCurrentName  = "white"

    local function hcNormalize(name)
        local s = string.lower(tostring(name or "")):gsub("^%s+",""):gsub("%s+$",""):gsub("[%s%-]+","_")
        return HC_ALIASES[s] or s
    end

    local function hcLookup(name)
        local entry = HC_COLOR_DB[hcNormalize(name)]
        if not entry then return nil end
        return Color3.fromRGB(entry.rgb[1], entry.rgb[2], entry.rgb[3])
    end

    local function hcIsIgnored(inst)
        for _, f in ipairs({"Map","Lobby"}) do
            local folder = workspace:FindFirstChild(f)
            if folder and inst:IsDescendantOf(folder) then return true end
        end
        return false
    end

    local function hcIsPlayerPart(inst)
        local model = inst:FindFirstAncestorOfClass("Model")
        if model and Players:GetPlayerFromCharacter(model) then
            local n = string.lower(inst.Name)
            if n:find("hitbox",1,true) or n:find("hurtbox",1,true) then return false end
            return true
        end
        return false
    end

    local function hcHasHitboxName(inst)
        local cur = inst
        while cur and cur ~= workspace do
            local n = string.lower(cur.Name)
            if n:find("hitbox",1,true) or n:find("hurtbox",1,true) then return true end
            cur = cur.Parent
        end
        return false
    end

    local function hcIsRedHitbox(part)
        if not hcConfig.DETECT_RED_HITBOXES then return false end
        if hcIsIgnored(part) or hcIsPlayerPart(part) then return false end
        if part.CanCollide then return false end
        local c = part.Color
        return c.R >= 0.72 and c.G <= 0.45 and c.B <= 0.45
    end

    local function hcIsTarget(inst)
        if inst:IsA("BasePart") then
            return hcHasHitboxName(inst) or hcIsRedHitbox(inst)
        elseif inst:IsA("SelectionBox") or inst:IsA("BoxHandleAdornment") or inst:IsA("Highlight") then
            return hcHasHitboxName(inst)
        end
        return false
    end

    local function hcApply(inst)
        if not hcActive or not inst or not inst.Parent then return end
        if not hcIsTarget(inst) then return end
        if inst:IsA("BasePart") then
            if not hcTracked[inst] then
                hcTracked[inst] = { kind="BasePart", color=inst.Color, material=inst.Material, transparency=inst.Transparency }
            end
            pcall(function()
                inst.Color = hcCurrentColor
                if hcConfig.USE_NEON then inst.Material = Enum.Material.Neon end
                if type(hcConfig.CUSTOM_TRANSPARENCY) == "number" then inst.Transparency = hcConfig.CUSTOM_TRANSPARENCY end
            end)
        elseif inst:IsA("SelectionBox") or inst:IsA("BoxHandleAdornment") then
            if not hcTracked[inst] then hcTracked[inst] = { kind="Adornment", color=inst.Color3 } end
            pcall(function() inst.Color3 = hcCurrentColor end)
        elseif inst:IsA("Highlight") then
            if not hcTracked[inst] then hcTracked[inst] = { kind="Highlight", fill=inst.FillColor, outline=inst.OutlineColor } end
            pcall(function() inst.FillColor = hcCurrentColor; inst.OutlineColor = hcCurrentColor end)
        end
    end

    local function hcRefresh()
        for inst in pairs(hcTracked) do
            if inst and inst.Parent then hcApply(inst) else hcTracked[inst] = nil end
        end
    end

    local function hcRestoreAll()
        for inst, saved in pairs(hcTracked) do
            if inst and inst.Parent then
                pcall(function()
                    if saved.kind == "BasePart" then
                        inst.Color = saved.color; inst.Material = saved.material; inst.Transparency = saved.transparency
                    elseif saved.kind == "Adornment" then
                        inst.Color3 = saved.color
                    elseif saved.kind == "Highlight" then
                        inst.FillColor = saved.fill; inst.OutlineColor = saved.outline
                    end
                end)
            end
            hcTracked[inst] = nil
        end
    end

    local function hcSetColor(name)
        local color = hcLookup(name)
        if not color then return false end
        hcCurrentColor = color
        hcCurrentName  = hcNormalize(name)
        hcRefresh()
        return true
    end

    local function hcUnload()
        if not hcActive then return end
        hcActive = false
        for i = #hcConnections, 1, -1 do
            local c = hcConnections[i]
            if c and c.Connected then pcall(function() c:Disconnect() end) end
            hcConnections[i] = nil
        end
        hcRestoreAll()
        rawset(_G, "__HITBOX_COLOR_UNLOAD", nil)
    end

    rawset(_G, "__HITBOX_COLOR_UNLOAD", hcUnload)

    table.insert(hcConnections, workspace.DescendantAdded:Connect(function(inst)
        if hcActive then hcApply(inst) end
    end))
    for _, inst in ipairs(workspace:GetDescendants()) do
        if not hcActive then break end
        hcApply(inst)
    end

    HC.setColor  = hcSetColor
    HC.unload    = hcUnload
    HC.config    = hcConfig
    HC.colorList = HC_COLOR_DB
end

