local function _GetSection(Tab)
    if not Tab then return nil end
    if not _TabSections[Tab] then
        local sec
        pcall(function()
            if type(Tab.CreateSection) == "function" then
                sec = Tab:CreateSection("General")
            elseif type(Tab.AddLeftGroupbox) == "function" then
                sec = Tab:AddLeftGroupbox("General")
            elseif type(Tab.AddRightGroupbox) == "function" then
                sec = Tab:AddRightGroupbox("General")
            elseif type(Tab.AddGroupbox) == "function" then
                sec = Tab:AddGroupbox({ Name = "General", Side = "Left" })
            elseif type(Tab.Section) == "function" then
                sec = Tab:Section({ Title = "General" })
            end
        end)
        if not sec then
            warn("[FlexSaken] No groupbox for tab — controls may be labels only")
        end
        _TabSections[Tab] = sec or Tab
    end
    return _TabSections[Tab]
end

local function AddSection(Tab, Title)
    if not Tab then return end
    local sec
    pcall(function()
        if type(Tab.CreateSection) == "function" then
            sec = Tab:CreateSection(Title)
        elseif type(Tab.AddLeftGroupbox) == "function" then
            sec = Tab:AddLeftGroupbox(Title)
        elseif type(Tab.AddGroupbox) == "function" then
            sec = Tab:AddGroupbox({ Name = Title, Side = "Left" })
        elseif type(Tab.Section) == "function" then
            sec = Tab:Section({ Title = Title })
        end
    end)
    if sec then _TabSections[Tab] = sec end
end

local function AddToggle(Tab, Key, Title, Default, Callback)
    local Value = Saved[Key]
    if type(Value) ~= "boolean" then Value = Default end
    State[Key] = Value
    local Element
    local Sec = _GetSection(Tab)

    local function onToggle(New)
        local v = New
        if type(v) == "table" and v.Value ~= nil then v = v.Value end
        State[Key] = v and true or false
        Saved[Key] = State[Key]
        SaveSettings()
        if Callback then task.spawn(SafeCall, Key, Callback, State[Key]) end
    end

    local Ok, Err = pcall(function()
        if not Sec then error("no section for toggle " .. tostring(Title)) end
        -- PRIMARY: Obsidian Groupbox:AddToggle(Idx, { Text, Default, Callback })
        if type(Sec.AddToggle) == "function" then
            Element = Sec:AddToggle(tostring(Key), {
                Text = tostring(Title),
                Default = Value,
                Callback = onToggle,
            })
            return
        end
        -- WindUI / other: Tab:Toggle({ Title, Value, Callback })
        if type(Sec.Toggle) == "function" then
            Element = Sec:Toggle({
                Title = tostring(Title),
                Text = tostring(Title),
                Value = Value,
                Default = Value,
                Callback = onToggle,
            })
            return
        end
        error("section has no AddToggle/Toggle")
    end)
    if not Ok then
        warn("[FlexSaken] Toggle '" .. tostring(Title) .. "' failed: " .. tostring(Err))
    end

    -- Prefer Library.Toggles registry + OnChanged (official Obsidian pattern)
    pcall(function()
        local T = (Library and Library.Toggles and Library.Toggles[Key]) or Element
        if T then
            if type(T.OnChanged) == "function" then
                T:OnChanged(function(v)
                    onToggle(v)
                end)
            end
            if type(T.SetValue) == "function" then
                T:SetValue(Value)
            end
            if type(T.SetText) == "function" then
                T:SetText(tostring(Title))
            end
            Element = T
        end
    end)

    Registry[Key] = { Kind = "toggle", Default = Default, Callback = Callback, Element = Element }
    if Callback and Value then task.defer(SafeCall, Key, Callback, Value) end
    return Element
end

local function AddSlider(Tab, Key, Title, Min, Max, Default, Step, Callback)
    local Value = Saved[Key]
    if type(Value) ~= "number" then Value = Default end
    -- clamp saved value into range
    if type(Value) == "number" then
        if Value < Min then Value = Min end
        if Value > Max then Value = Max end
    end
    State[Key] = Value
    local Element
    local Sec = _GetSection(Tab)
    local step = Step or 1
    -- Obsidian Rounding is decimal places, not step size
    local rounding = 0
    if type(step) == "number" then
        if step >= 1 then
            rounding = 0
        else
            local s = tostring(step)
            local dot = s:find("%.")
            rounding = dot and (#s - dot) or 2
            if rounding > 4 then rounding = 4 end
        end
    end

    local function onSlide(New)
        local v = New
        if type(v) == "table" then
            v = v.Value or v.Default or v[1]
        end
        v = tonumber(v)
        if not v then return end
        if v < Min then v = Min end
        if v > Max then v = Max end
        State[Key] = v
        Saved[Key] = v
        SaveSettings()
        if Callback then task.spawn(SafeCall, Key, Callback, v) end
    end

    local Ok, Err = pcall(function()
        if not Sec then error("no section for slider " .. tostring(Title)) end
        if type(Sec.AddSlider) == "function" then
            -- Official Obsidian: AddSlider(Idx, { Text, Default, Min, Max, Rounding, Callback })
            Element = Sec:AddSlider(tostring(Key), {
                Text = tostring(Title),
                Default = Value,
                Min = Min,
                Max = Max,
                Rounding = rounding,
                Compact = false,
                Callback = onSlide,
            })
            return
        end
        if type(Sec.Slider) == "function" then
            Element = Sec:Slider({
                Title = tostring(Title),
                Text = tostring(Title),
                Min = Min,
                Max = Max,
                Default = Value,
                Step = step,
                Increment = step,
                Rounding = rounding,
                Value = { Min = Min, Max = Max, Default = Value },
                Callback = onSlide,
            })
            return
        end
        error("section has no AddSlider/Slider")
    end)
    if not Ok then
        warn("[FlexSaken] Slider '" .. tostring(Title) .. "' failed: " .. tostring(Err))
    end

    -- Bind Library.Options OnChanged (Obsidian stores sliders here)
    pcall(function()
        local O = nil
        if Library and Library.Options then
            O = Library.Options[Key] or Library.Options[tostring(Key)]
        end
        O = O or Element
        if not O then return end
        if type(O.OnChanged) == "function" then
            O:OnChanged(function(v)
                onSlide(v)
            end)
        end
        if type(O.SetValue) == "function" then
            O:SetValue(Value)
        end
        if type(O.SetText) == "function" then
            O:SetText(tostring(Title))
        end
        -- Some builds need :SetMin / :SetMax to enable dragging
        if type(O.SetMin) == "function" then pcall(O.SetMin, O, Min) end
        if type(O.SetMax) == "function" then pcall(O.SetMax, O, Max) end
        Element = O
    end)

    if Callback then task.defer(SafeCall, Key, Callback, Value) end
    Registry[Key] = { Kind = "slider", Default = Default, Callback = Callback, Element = Element }
    return Element
end

local function AddDropdown(Tab, Key, Title, Values, Default, Callback)
    local Value = Saved[Key]
    if type(Value) ~= "string" or not table.find(Values, Value) then Value = Default end
    State[Key] = Value
    local Element
    local Sec = _GetSection(Tab)

    local function onPick(New)
