    local AccentLine = Instance.new("Frame"); AccentLine.Size = UDim2.new(1,0,0,2); AccentLine.Position = UDim2.new(0,0,1,-2)
    AccentLine.BackgroundColor3 = accent; AccentLine.BorderSizePixel = 0; AccentLine.Parent = TitleBar
    local TitleLabel = Instance.new("TextLabel"); TitleLabel.Size = UDim2.new(1,-100,1,0); TitleLabel.Position = UDim2.fromOffset(16,0)
    TitleLabel.BackgroundTransparency = 1; TitleLabel.Font = Enum.Font.GothamBold; TitleLabel.TextSize = 15
    TitleLabel.TextColor3 = Theme.Text; TitleLabel.TextXAlignment = Enum.TextXAlignment.Left; TitleLabel.Text = title; TitleLabel.Parent = TitleBar

    -- Window subtitle / badge
    local BadgeLbl = Instance.new("TextLabel"); BadgeLbl.Size = UDim2.new(0,120,0,16); BadgeLbl.Position = UDim2.new(1,-180,0.5,-8)
    BadgeLbl.BackgroundTransparency=1; BadgeLbl.Font=Enum.Font.Gotham; BadgeLbl.TextSize=10
    BadgeLbl.TextColor3=Theme.TextDim; BadgeLbl.TextXAlignment=Enum.TextXAlignment.Right; BadgeLbl.Text="by Ethan & Luna"; BadgeLbl.Parent=TitleBar

    local CloseBtn = Instance.new("TextButton"); CloseBtn.Size = UDim2.fromOffset(28,28); CloseBtn.Position = UDim2.new(1,-36,0.5,-14)
    CloseBtn.BackgroundColor3 = Theme.Surface2; CloseBtn.BorderSizePixel = 0; CloseBtn.Text = "×"
    CloseBtn.Font = Enum.Font.GothamBold; CloseBtn.TextSize = 18; CloseBtn.TextColor3 = Theme.TextDim
    CloseBtn.AutoButtonColor = false; CloseBtn.Parent = TitleBar; round(CloseBtn,6)
    CloseBtn.MouseEnter:Connect(function() tween(CloseBtn,{BackgroundColor3=Theme.Danger,TextColor3=Color3.new(1,1,1)},0.12) end)
    CloseBtn.MouseLeave:Connect(function() tween(CloseBtn,{BackgroundColor3=Theme.Surface2,TextColor3=Theme.TextDim},0.12) end)
    CloseBtn.MouseButton1Click:Connect(function() Main.Visible = false end)

    local dragging, dragStart, startPos
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=Main.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging=false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
        end
    end)

    local Sidebar = Instance.new("Frame"); Sidebar.Size = UDim2.new(0,158,1,-42); Sidebar.Position = UDim2.new(0,0,0,42)
    Sidebar.BackgroundColor3 = Theme.Surface; Sidebar.BorderSizePixel = 0; Sidebar.Parent = Main
    local SideScroll = Instance.new("ScrollingFrame"); SideScroll.Size = UDim2.new(1,0,1,-36)
    SideScroll.BackgroundTransparency = 1; SideScroll.BorderSizePixel = 0; SideScroll.ScrollBarThickness = 3
    SideScroll.ScrollBarImageColor3 = Theme.Border; SideScroll.CanvasSize = UDim2.new(0,0,0,0)
    SideScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y; SideScroll.Parent = Sidebar
    pad(SideScroll,8,10,8,10); listLayout(SideScroll,Enum.FillDirection.Vertical,4)
    local FooterLabel = Instance.new("TextLabel"); FooterLabel.Size = UDim2.new(1,-12,0,28); FooterLabel.Position = UDim2.new(0,6,1,-30)
    FooterLabel.BackgroundTransparency=1; FooterLabel.Font=Enum.Font.Gotham; FooterLabel.TextSize=10
    FooterLabel.TextColor3=Theme.TextDim; FooterLabel.TextXAlignment=Enum.TextXAlignment.Left
    FooterLabel.TextTruncate=Enum.TextTruncate.AtEnd; FooterLabel.Text=footer; FooterLabel.Parent=Sidebar

    local Content = Instance.new("Frame"); Content.Size = UDim2.new(1,-158,1,-42); Content.Position = UDim2.new(0,158,0,42)
    Content.BackgroundColor3 = Theme.Background; Content.BorderSizePixel = 0; Content.ClipsDescendants = true; Content.Parent = Main

    local Window = { ScreenGui=ScreenGui, Main=Main, Tabs={}, ActiveTab=nil, _tabButtons={} }

    local function setActiveTab(tabName)
        for name, page in pairs(Window.Tabs) do page.Visible = (name==tabName) end
        for name, btn in pairs(Window._tabButtons) do
            if name==tabName then tween(btn,{BackgroundColor3=Theme.AccentDim},0.12); btn.TextColor3=Theme.Text
            else tween(btn,{BackgroundColor3=Theme.Surface},0.12); btn.TextColor3=Theme.TextDim end
        end
        Window.ActiveTab = tabName
    end

    function Window:CreateTab(tabName)
        tabName = tostring(tabName)
        local btn = Instance.new("TextButton"); btn.Size = UDim2.new(1,0,0,32)
        btn.BackgroundColor3=Theme.Surface; btn.BorderSizePixel=0; btn.Font=Enum.Font.GothamMedium; btn.TextSize=12
        btn.TextColor3=Theme.TextDim; btn.Text=tabName; btn.TextXAlignment=Enum.TextXAlignment.Left
        btn.AutoButtonColor=false; btn.Parent=SideScroll; round(btn,6); pad(btn,12,0,8,0)
        btn.MouseEnter:Connect(function() if Window.ActiveTab~=tabName then tween(btn,{BackgroundColor3=Theme.Surface2},0.1) end end)
        btn.MouseLeave:Connect(function() if Window.ActiveTab~=tabName then tween(btn,{BackgroundColor3=Theme.Surface},0.1) end end)
        btn.MouseButton1Click:Connect(function() setActiveTab(tabName) end)
        Window._tabButtons[tabName] = btn

        local page = Instance.new("ScrollingFrame"); page.Name = "Tab_"..tabName
        page.Size=UDim2.new(1,0,1,0); page.BackgroundTransparency=1; page.BorderSizePixel=0
        page.ScrollBarThickness=4; page.ScrollBarImageColor3=Theme.Border; page.CanvasSize=UDim2.new(0,0,0,0)
        page.AutomaticCanvasSize=Enum.AutomaticSize.Y; page.Visible=false; page.Parent=Content
        pad(page,14,12,14,14); listLayout(page,Enum.FillDirection.Vertical,10)
        Window.Tabs[tabName] = page
        if not Window.ActiveTab then setActiveTab(tabName) end

        local TabObj = { Name=tabName, Page=page, _sections={} }

        function TabObj:CreateSection(sectionName)
            sectionName = tostring(sectionName or "General")
            local box = Instance.new("Frame"); box.Size=UDim2.new(1,0,0,0); box.AutomaticSize=Enum.AutomaticSize.Y
            box.BackgroundColor3=Theme.Surface; box.BorderSizePixel=0; box.Parent=page
            round(box,8); stroke(box,Theme.Border,1,0.5); pad(box,12,10,12,12); listLayout(box,Enum.FillDirection.Vertical,8)
            local header = Instance.new("TextLabel"); header.Size=UDim2.new(1,0,0,20); header.BackgroundTransparency=1
            header.Font=Enum.Font.GothamBold; header.TextSize=12; header.TextColor3=accent
            header.TextXAlignment=Enum.TextXAlignment.Left; header.Text=sectionName:upper(); header.Parent=box

            local Sec = { Frame=box, Name=sectionName }

            function Sec:AddToggle(idx, cfg)
                cfg = type(idx)=="table" and idx or (cfg or {})
                if type(idx)=="string" then cfg.Idx=idx end
                local key = tostring(cfg.Idx or cfg.Text or HttpService:GenerateGUID(false):sub(1,8))
                local text = cfg.Text or cfg.Title or key
                local default = cfg.Default; if default==nil then default=false end
                local callback = cfg.Callback or cfg.Func
                local row = Instance.new("Frame"); row.Size=UDim2.new(1,0,0,28); row.BackgroundTransparency=1; row.Parent=box
                local lbl = Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-52,1,0); lbl.BackgroundTransparency=1
                lbl.Font=Enum.Font.Gotham; lbl.TextSize=13; lbl.TextColor3=Theme.Text
                lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Text=text; lbl.Parent=row
                local track = Instance.new("Frame"); track.Size=UDim2.fromOffset(42,22); track.Position=UDim2.new(1,-42,0.5,-11)
                track.BackgroundColor3=default and Theme.ToggleOn or Theme.ToggleOff; track.BorderSizePixel=0; track.Parent=row; round(track,11)
                local knob = Instance.new("Frame"); knob.Size=UDim2.fromOffset(16,16)
                knob.Position=default and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)
                knob.BackgroundColor3=Color3.new(1,1,1); knob.BorderSizePixel=0; knob.Parent=track; round(knob,8)
                local state = default
                local function set(v, fire)
                    state = not not v
                    tween(track,{BackgroundColor3=state and Theme.ToggleOn or Theme.ToggleOff},0.15)
                    tween(knob,{Position=state and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)},0.15)
                    if fire and callback then task.spawn(callback,state) end
                end
                local hit = Instance.new("TextButton"); hit.Size=UDim2.new(1,0,1,0); hit.BackgroundTransparency=1; hit.Text=""; hit.Parent=row
                hit.MouseButton1Click:Connect(function() set(not state,true) end)
                local obj = {Value=state,SetValue=function(_,v) set(v,true) end,OnChanged=function(_,fn) callback=fn end,SetText=function(_,t) lbl.Text=tostring(t) end}
                KanhaUI.Toggles[key] = obj
                if default and callback then task.defer(callback,true) end
                return obj
            end

            function Sec:AddSlider(idx, cfg)
                cfg = type(idx)=="table" and idx or (cfg or {})
                if type(idx)=="string" then cfg.Idx=idx end
                local key = tostring(cfg.Idx or cfg.Text or HttpService:GenerateGUID(false):sub(1,8))
                local text = cfg.Text or cfg.Title or key
                local minV=cfg.Min or 0; local maxV=cfg.Max or 100
