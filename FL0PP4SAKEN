local ItemReach = {}
do
    local irOriginals   = setmetatable({}, { __mode = "k" })
    local irConnections = {}

    local irConfig = {
        Enabled            = false,
        MaxDistance        = 23,
        DisableLineOfSight = true,
        ItemKeywords       = { "medkit", "bloxy", "cola", "gear", "fruit" },
    }

    local function irMatches(text)
        local lower = string.lower(text)
        for _, kw in ipairs(irConfig.ItemKeywords) do
            if string.find(lower, kw, 1, true) then return true end
        end
        return false
    end

    local function irIsTarget(inst)
        if inst:IsA("ProximityPrompt") then
            if irMatches(inst.ObjectText) or irMatches(inst.ActionText) or irMatches(inst.Name) then return true end
        elseif inst:IsA("ClickDetector") then
            if irMatches(inst.Name) then return true end
        else return false end
        local curr, depth = inst.Parent, 0
        while curr and curr ~= workspace and depth < 4 do
            if irMatches(curr.Name) then return true end
            curr = curr.Parent; depth += 1
        end
        return false
    end

    local function irApply(inst)
        if not irConfig.Enabled or not irIsTarget(inst) then return end
        if inst:IsA("ProximityPrompt") then
            if not irOriginals[inst] then irOriginals[inst] = { MaxActivationDistance = inst.MaxActivationDistance, RequiresLineOfSight = inst.RequiresLineOfSight } end
            inst.MaxActivationDistance = irConfig.MaxDistance
            if irConfig.DisableLineOfSight then inst.RequiresLineOfSight = false end
        elseif inst:IsA("ClickDetector") then
            if not irOriginals[inst] then irOriginals[inst] = { MaxActivationDistance = inst.MaxActivationDistance } end
            inst.MaxActivationDistance = irConfig.MaxDistance
        end
    end

    local function irRestoreAll()
        for inst, backup in pairs(irOriginals) do
