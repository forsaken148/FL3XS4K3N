        end
    else
        -- last resort global search
        FlowInputModule = FlowInputModule or select(1, findModuleByName(ReplicatedStorage, "FlowInput"))
        GearInputModule = GearInputModule or select(1, findModuleByName(ReplicatedStorage, "GearInput"))
        LockInputModule = LockInputModule or select(1, findModuleByName(ReplicatedStorage, "LockInput"))
        ConnectInputModule = ConnectInputModule or select(1, findModuleByName(ReplicatedStorage, "ConnectInput"))
    end

    local ready = FlowBoardModule and LockBoardModule and FlowInputModule and ConnectInputModule
    if not ready then
        warn("[FlexSaken] Generator solver modules incomplete — will retry on enable")
        warn(string.format(
            "[FlexSaken] FlowBoard=%s LockBoard=%s FlowInput=%s ConnectInput=%s GearInput=%s MinigameFolder=%s",
            tostring(FlowBoardModule ~= nil),
            tostring(LockBoardModule ~= nil),
            tostring(FlowInputModule ~= nil),
            tostring(ConnectInputModule ~= nil),
            tostring(GearInputModule ~= nil),
            tostring(MinigameFolder ~= nil)
        ))
    else
        print("[FlexSaken] Generator solver modules ready")
    end
    return ready
end

Risky("GeneratorModules", function()
