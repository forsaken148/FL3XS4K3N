-- Compatibility shim: the new deividcomsono/Obsidian API uses AddTab/AddLeftGroupbox
-- instead of the old CreateTab/CreateSection. Wrap it so the rest of the script
-- (which calls CreateTab and CreateSection) works without changes.
if Library then
    -- Wrap Library:CreateWindow so its result has :CreateTab
    local _origCreateWindow = Library.CreateWindow
    Library.CreateWindow = function(self, opts)
        -- Map old option keys to new ones
        if opts then
            if opts.Name and not opts.Title then opts.Title = opts.Name end
            if opts.Themename then opts.Themename = nil end -- not used in new API
            if opts.ToggleKey then
                opts.ToggleKeybind = opts.ToggleKey
                opts.ToggleKey = nil
            end
        end
        local win = _origCreateWindow(self, opts)
        if not win then return win end

        -- inject :CreateTab onto the window object
        win.CreateTab = function(_, tabName)
            local tab
            pcall(function()
                if type(win.AddTab) == "function" then
                    tab = win:AddTab(tabName)
                end
            end)
            if not tab then
                pcall(function()
                    if type(win.AddTab) == "function" then
                        tab = win:AddTab({ Name = tabName, Title = tabName, Icon = "rbxassetid://0" })
                    end
                end)
            end
            if not tab then return nil end
            local function wrapAdder(orig)
                return function(gbSelf, info, ...)
                    if type(info) == "table" then
                        -- Always force a visible label
                        local label = info.Text or info.Name or info.Title
                        if label then
                            info.Text = label
                            info.Name = label
                            info.Title = label
                        end
                        if info.Increment and not info.Rounding then
                            info.Rounding = info.Increment
                        end
                        if info.Options and not info.Values then
                            info.Values = info.Options
                        end
                        if info.Callback and not info.Func then
                            info.Func = info.Callback
                        end
                    end
                    return orig(gbSelf, info, ...)
                end
            end
            local function wrapGroupbox(gb)
                if not gb then return gb end
                if gb.AddToggle then gb.AddToggle = wrapAdder(gb.AddToggle) end
                if gb.AddSlider then gb.AddSlider = wrapAdder(gb.AddSlider) end
                if gb.AddDropdown then gb.AddDropdown = wrapAdder(gb.AddDropdown) end
                if gb.AddTextbox then gb.AddTextbox = wrapAdder(gb.AddTextbox) end
                if gb.AddInput then gb.AddInput = wrapAdder(gb.AddInput) end
                if gb.AddButton then
                    local raw = gb.AddButton
                    gb.AddButton = function(gbSelf, info, ...)
                        if type(info) == "table" then
                            local label = info.Text or info.Name or info.Title
                            if label then info.Text = label; info.Name = label; info.Title = label end
                            if info.Callback and not info.Func then info.Func = info.Callback end
                        end
                        return raw(gbSelf, info, ...)
                    end
                end
                return gb
            end
            local function wrapTab(t)
                t.CreateSection = function(_, sectionName)
                    local gb
                    pcall(function()
                        if type(t.AddLeftGroupbox) == "function" then
                            gb = t:AddLeftGroupbox(sectionName or "General")
                        elseif type(t.AddGroupbox) == "function" then
                            gb = t:AddGroupbox({ Name = sectionName or "General", Side = "Left" })
                        elseif type(t.AddRightGroupbox) == "function" then
                            gb = t:AddRightGroupbox(sectionName or "General")
                        end
                    end)
                    if not gb then return t end
                    return wrapGroupbox(gb)
                end
                -- also expose AddLeftGroupbox so direct callers work
                if type(t.AddLeftGroupbox) == "function" then
                    local rawLeft = t.AddLeftGroupbox
                    t.AddLeftGroupbox = function(self, name)
                        return wrapGroupbox(rawLeft(self, name))
                    end
                end
                return t
            end
            return wrapTab(tab)
        end
        return win
    end

    -- Wrap Library:Notify for old {Title, Content, Duration} format
    local _origNotify = Library.Notify
    Library.Notify = function(self, info)
        if type(info) == "table" then
            if info.Content and not info.Description then
                info.Description = info.Content
                info.Content = nil
            end
            if info.Duration and not info.Time then
                info.Time = info.Duration
                info.Duration = nil
            end
        end
        return _origNotify(self, info)
    end
end

