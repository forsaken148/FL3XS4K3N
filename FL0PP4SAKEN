        HOLD_DURATION_SEC    = 2.20,
        AIM_EXTRA_WINDOW_SEC = 0.55,
        AIM_MAX_RANGE        = 22.0,
        PREDICTION_SPEED     = 42.0,
        MAX_LEAD_SEC         = 0.20,
        COOLDOWN_SEC         = 5.0,
        ONLY_AS_SIXER        = true,
    }

    local sabState = {
        isHolding = false, synthetic = false, heldBtn = nil,
        lastTriggerAt = 0, aimBound = false, aimUntil = 0,
        lockedTarget = nil, rotLocked = false,
    }

    local function sabClearList(list)
        for i = #list, 1, -1 do
            local c = list[i]; list[i] = nil
            pcall(function() c:Disconnect() end)
        end
    end

    local function sabIsLocalSixer(character)
        if not sabCONFIG.ONLY_AS_SIXER then return true end
        character = character or LocalPlayer.Character
        if not (character and character.Parent and character.Parent.Name == "Killers") then return false end
        local name = tostring(character:GetAttribute("CharacterName") or character:GetAttribute("ActorDisplayName") or character.Name)
        local normalized = name:gsub("^[!#]", ""):lower()
        return normalized == "sixer" or normalized == "guest666" or normalized == "guest 666"
    end

    local function sabFindNearest(myPos, maxDist)
        local pf = workspace:FindFirstChild("Players")
        local sf = pf and pf:FindFirstChild("Survivors")
        if not sf then return nil end
        local closest, closestDist = nil, maxDist
        for _, survivor in ipairs(sf:GetChildren()) do
            if survivor:IsA("Model") and survivor ~= LocalPlayer.Character and not survivor:GetAttribute("Undetectable") then
                local root = survivor:FindFirstChild("HumanoidRootPart")
                local hum  = survivor:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local d = (root.Position - myPos).Magnitude
                    if d <= closestDist then closestDist = d; closest = root end
                end
            end
        end
        return closest
    end

    local function sabUnlockRot(hum)
        if not sabState.rotLocked then return end
        sabState.rotLocked = false
        hum = hum or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
        if hum and hum.Parent then pcall(function() hum.AutoRotate = true end) end
    end

    local function sabStopAim()
        if sabState.aimBound then
            sabState.aimBound = false
            pcall(function() RunService:UnbindFromRenderStep(AIM_STEP_NAME) end)
        end
        sabState.aimUntil = 0; sabState.lockedTarget = nil
        sabUnlockRot(nil)
    end

    local function sabStepAim()
        if not sabActive or not sabCONFIG.BODY_AIMBOT or os.clock() > sabState.aimUntil then sabStopAim(); return end
        local character = LocalPlayer.Character
        if not sabIsLocalSixer(character) then sabStopAim(); return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local hum  = character:FindFirstChildOfClass("Humanoid")
        if not (root and hum and hum.Health > 0) then sabStopAim(); return end
        local target = nil
        local locked = sabState.lockedTarget
        if locked and locked.Parent then
            local tm = locked.Parent
            local th = tm:FindFirstChildOfClass("Humanoid")
            if tm.Parent and tm.Parent.Name == "Survivors" and not tm:GetAttribute("Undetectable") and th and th.Health > 0 and (locked.Position - root.Position).Magnitude <= sabCONFIG.AIM_MAX_RANGE then
                target = locked
            end
        end
        if not target then target = sabFindNearest(root.Position, sabCONFIG.AIM_MAX_RANGE); sabState.lockedTarget = target end
        if not target then sabUnlockRot(hum); return end
        local aimPos = target.Position
        if sabCONFIG.PREDICTION_SPEED > 0 then
            local vel  = target.AssemblyLinearVelocity
            local hvel = Vector3.new(vel.X, 0, vel.Z)
            if hvel.Magnitude > 1.0 and hvel.Magnitude < 90 then
                local leadTime = math.clamp((aimPos - root.Position).Magnitude / sabCONFIG.PREDICTION_SPEED, 0.02, sabCONFIG.MAX_LEAD_SEC)
                aimPos = aimPos + hvel * leadTime
            end
        end
        local dir = Vector3.new(aimPos.X - root.Position.X, 0, aimPos.Z - root.Position.Z)
        if dir.Magnitude > 0.05 then
            sabState.rotLocked = true
            hum.AutoRotate = false
            pcall(function() root.AssemblyAngularVelocity = Vector3.zero end)
            root.CFrame = CFrame.lookAt(root.Position, Vector3.new(aimPos.X, root.Position.Y, aimPos.Z))
        end
    end

    local function sabStartAim(duration)
        if not sabActive or not sabCONFIG.BODY_AIMBOT then return end
        sabState.aimUntil = math.max(sabState.aimUntil, os.clock() + duration)
        sabStepAim()
        if not sabState.aimBound and sabState.aimUntil > os.clock() then
            sabState.aimBound = true
            pcall(function()
                RunService:UnbindFromRenderStep(AIM_STEP_NAME)
                RunService:BindToRenderStep(AIM_STEP_NAME, Enum.RenderPriority.Character.Value + 5, sabStepAim)
            end)
        end
    end

    local function sabReleaseHold()
        local btn = sabState.heldBtn; sabState.heldBtn = nil
        if btn and type(firesignal) == "function" then
            sabState.synthetic = true
            pcall(function() if btn.MouseButton1Up then firesignal(btn.MouseButton1Up) end end)
            sabState.synthetic = false
        end
        sabState.isHolding = false
    end

    local function sabTrigger(clickButton)
        if not sabActive or not sabCONFIG.ENABLED or sabState.isHolding or not clickButton then return end
        if not sabIsLocalSixer(LocalPlayer.Character) then return end
        local now = os.clock()
        if now - sabState.lastTriggerAt < sabCONFIG.COOLDOWN_SEC then return end
        sabState.lastTriggerAt = now
        sabState.isHolding = true
        sabStartAim(sabCONFIG.HOLD_DURATION_SEC + sabCONFIG.AIM_EXTRA_WINDOW_SEC)
        task.spawn(function()
            local released = false
            local endConn = clickButton.MouseButton1Up:Connect(function() released = true end)
            local deadline = os.clock() + 0.12
            while not released and os.clock() < deadline and sabActive and sabState.isHolding do RunService.Heartbeat:Wait() end
            pcall(function() endConn:Disconnect() end)
            if not sabActive or not sabCONFIG.ENABLED or not sabState.isHolding then sabReleaseHold(); return end
            if type(firesignal) ~= "function" or not clickButton.MouseButton1Down then sabState.isHolding = false; return end
            sabState.synthetic = true
            pcall(function() firesignal(clickButton.MouseButton1Down); sabState.heldBtn = clickButton end)
            sabState.synthetic = false
            local holdDeadline = os.clock() + sabCONFIG.HOLD_DURATION_SEC
            while sabActive and sabState.isHolding and os.clock() < holdDeadline do
                local char = LocalPlayer.Character
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                if not (sabIsLocalSixer(char) and hum and hum.Health > 0) then break end
                RunService.Heartbeat:Wait()
            end
            sabReleaseHold()
        end)
    end

    local function sabFindContainer()
        local pg  = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        local mui = pg and pg:FindFirstChild("MainUI")
        local ac  = mui and mui:FindFirstChild("AbilityContainer")
        if not ac then return nil end
        local exact = ac:FindFirstChild("Carving Slash") or ac:FindFirstChild("CarvingSlash")
        if exact then return exact end
        for _, child in ipairs(ac:GetChildren()) do
            local n = child.Name:lower()
            if n:find("carving",1,true) or n:find("eviscerat",1,true) or n == "slash" then return child end
            local lbl = child:FindFirstChild("AbilityName")
            if lbl and lbl:IsA("TextLabel") then
                local t = tostring(lbl.Text or ""):lower()
                if t:find("carving",1,true) or t:find("eviscerat",1,true) then return child end
            end
        end
        return nil
    end

    local function sabBind()
        if not sabActive then return end
        local container = sabFindContainer()
        if not container then return end
        if sabHookedContainer == container and container.Parent ~= nil then return end
        sabClearList(sabButtonConns)
        sabHookedContainer = container
        local clickButton = (container:IsA("GuiButton") and container) or container:FindFirstChildWhichIsA("GuiButton", true)
        if not clickButton then return end
        local function onTap()
            if not sabActive or not sabCONFIG.ENABLED or sabState.synthetic or sabState.isHolding then return end
            if os.clock() - sabState.lastTriggerAt < sabCONFIG.COOLDOWN_SEC then return end
            sabTrigger(clickButton)
        end
        table.insert(sabButtonConns, clickButton.MouseButton1Down:Connect(onTap))
        table.insert(sabButtonConns, clickButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then onTap() end
        end))
        table.insert(sabButtonConns, container.AncestryChanged:Connect(function(_, parent)
            if not parent and sabHookedContainer == container then sabHookedContainer = nil; sabClearList(sabButtonConns) end
        end))
    end

    local function sabUnload(reason)
        if not sabActive then return end
        sabActive = false
        sabReleaseHold(); sabStopAim()
        sabClearList(sabButtonConns); sabClearList(sabConnections)
        sabHookedContainer = nil
        rawset(_G, "__SIXER_AUTOBITE_UNLOAD", nil)
    end

    local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
    if pg then
        table.insert(sabConnections, pg.DescendantAdded:Connect(function(desc)
            if not sabActive then return end
            local n = desc.Name:lower()
            if n:find("carving",1,true) or n:find("eviscerat",1,true) or desc.Name == "AbilityContainer" then task.defer(sabBind) end
        end))
    end
    table.insert(sabConnections, LocalPlayer.CharacterAdded:Connect(function()
        if sabActive then sabReleaseHold(); sabStopAim(); sabState.lastTriggerAt = 0; task.delay(0.6, sabBind) end
    end))
    sabBind()
    rawset(_G, "__SIXER_AUTOBITE_UNLOAD", sabUnload)

    SAB.config  = sabCONFIG
    SAB.unload  = sabUnload
    SAB.rebind  = sabBind
end

