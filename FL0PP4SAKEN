        end
        State[Key] = v
        Saved[Key] = v
        SaveSettings()
        if Callback then task.spawn(SafeCall, Key, Callback, v) end
    end

    local Ok, Err = pcall(function()
        if not Sec then error("no section for dropdown " .. tostring(Title)) end
        if type(Sec.AddDropdown) == "function" then
            Element = Sec:AddDropdown(tostring(Key), {
                Text = tostring(Title),
                Values = Values,
                Default = Value,
                Callback = onPick,
            })
            return
        end
        if type(Sec.Dropdown) == "function" then
            Element = Sec:Dropdown({
                Title = tostring(Title),
                Text = tostring(Title),
                Values = Values,
                Value = Value,
                Default = Value,
                Callback = onPick,
            })
            return
        end
        error("section has no AddDropdown/Dropdown")
    end)
    if not Ok then
        warn("[FlexSaken] Dropdown '" .. tostring(Title) .. "' failed: " .. tostring(Err))
    end

    pcall(function()
        local O = (Library and Library.Options and Library.Options[Key]) or Element
        if O then
            if type(O.OnChanged) == "function" then O:OnChanged(function(v) onPick(v) end) end
            if type(O.SetValue) == "function" then O:SetValue(Value) end
            if type(O.SetText) == "function" then O:SetText(tostring(Title)) end
            Element = O
        end
