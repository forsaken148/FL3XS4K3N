                track.BackgroundColor3=Theme.SliderTrack; track.BorderSizePixel=0; track.Parent=row; round(track,3)
                local pct=(default-minV)/math.max(1e-9,maxV-minV)
                local fill = Instance.new("Frame"); fill.Size=UDim2.new(pct,0,1,0); fill.BackgroundColor3=Theme.SliderFill; fill.BorderSizePixel=0; fill.Parent=track; round(fill,3)
                local knob = Instance.new("Frame"); knob.Size=UDim2.fromOffset(14,14); knob.Position=UDim2.new(pct,-7,0.5,-7)
                knob.BackgroundColor3=Color3.new(1,1,1); knob.BorderSizePixel=0; knob.Parent=track; round(knob,7); stroke(knob,accent,1,0)
                local function fmt(v) if rounding<=0 then return tostring(math.floor(v+0.5)) end local m=10^rounding; return string.format("%."..rounding.."f",math.floor(v*m+0.5)/m) end
                local value=default
                local function apply(v,fire)
                    v=math.clamp(v,minV,maxV)
                    if rounding<=0 then v=math.floor(v+0.5) else local m=10^rounding; v=math.floor(v*m+0.5)/m end
                    value=v; local p=(v-minV)/math.max(1e-9,maxV-minV)
                    fill.Size=UDim2.new(p,0,1,0); knob.Position=UDim2.new(p,-7,0.5,-7); valLbl.Text=fmt(v)
                    if fire and callback then task.spawn(callback,v) end
                end
                local sliding=false
                local function fromInput(x)
                    local abs=track.AbsolutePosition.X; local w=track.AbsoluteSize.X
                    apply(minV+math.clamp((x-abs)/math.max(1,w),0,1)*(maxV-minV),true)
                end
                track.InputBegan:Connect(function(input)
                    if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then sliding=true; fromInput(input.Position.X) end
