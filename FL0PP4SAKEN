local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- KEY SYSTEM
-- ============================================================
do
    local VALID_KEY = "Fl3xs4ken-by_3than-and_luna"
    local SAVE_FILE = "FlexSaken_Key.txt"

    local function ReadSaved()
        if typeof(readfile) == "function" then
            local ok, data = pcall(readfile, SAVE_FILE)
            if ok and type(data) == "string" then return data:match("^%s*(.-)%s*$") end
        end
        return nil
    end
    local function SaveKey(key)
        if typeof(writefile) == "function" then pcall(writefile, SAVE_FILE, key) end
    end

    local saved = ReadSaved()
    if saved ~= VALID_KEY then
        local verified = false
        local SG = Instance.new("ScreenGui")
        SG.Name = "FlexSakenKey"; SG.ResetOnSpawn = false
        SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        SG.DisplayOrder = 9999
        pcall(function() SG.Parent = CoreGui end)
        if not SG.Parent then SG.Parent = LocalPlayer:WaitForChild("PlayerGui") end

        local Bg = Instance.new("Frame", SG)
        Bg.Size = UDim2.new(1,0,1,0); Bg.BackgroundColor3 = Color3.fromRGB(8,8,12)
        Bg.BorderSizePixel = 0

        local Card = Instance.new("Frame", Bg)
        Card.Size = UDim2.new(0,400,0,260)
        Card.Position = UDim2.new(0.5,-200,0.5,-130)
        Card.BackgroundColor3 = Color3.fromRGB(18,18,26); Card.BorderSizePixel = 0
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0,12)

        local AccBar = Instance.new("Frame", Card)
        AccBar.Size = UDim2.new(1,0,0,3); AccBar.BackgroundColor3 = Color3.fromRGB(220,50,80); AccBar.BorderSizePixel = 0
        Instance.new("UICorner", AccBar).CornerRadius = UDim.new(0,12)

        local function lbl(parent, text, size, y, bold, color)
            local l = Instance.new("TextLabel", parent)
            l.Size = UDim2.new(1,0,0,size or 24); l.Position = UDim2.new(0,0,0,y or 0)
            l.BackgroundTransparency = 1; l.Text = text
            l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
            l.TextSize = size or 13; l.TextColor3 = color or Color3.new(1,1,1)
            return l
        end
        lbl(Card,"⚔  FLEX SAKEN",20,14,true)
        lbl(Card,"Enter your key to continue",13,52,false,Color3.fromRGB(160,160,180))

        local Box = Instance.new("TextBox", Card)
        Box.Size = UDim2.new(0,340,0,42); Box.Position = UDim2.new(0.5,-170,0,92)
        Box.BackgroundColor3 = Color3.fromRGB(28,28,40); Box.TextColor3 = Color3.fromRGB(230,230,230)
        Box.PlaceholderText = "Paste key here..."; Box.PlaceholderColor3 = Color3.fromRGB(90,90,110)
        Box.Text = ""; Box.Font = Enum.Font.Code; Box.TextSize = 13
        Box.ClearTextOnFocus = false; Box.BorderSizePixel = 0
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0,8)
        local bp = Instance.new("UIPadding", Box); bp.PaddingLeft = UDim.new(0,10); bp.PaddingRight = UDim.new(0,10)

        local Status = lbl(Card,"",12,142,false,Color3.fromRGB(220,60,80))

        local function makeBtn(parent, text, x, color)
            local b = Instance.new("TextButton", parent)
            b.Size = UDim2.new(0,162,0,40); b.Position = UDim2.new(0.5,-170+x,0,168)
            b.BackgroundColor3 = color; b.TextColor3 = Color3.new(1,1,1)
            b.Text = text; b.Font = Enum.Font.GothamBold; b.TextSize = 14
            b.BorderSizePixel = 0; b.AutoButtonColor = false
            Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
            return b
        end
        local Submit = makeBtn(Card,"Submit Key",0,Color3.fromRGB(220,50,80))
        local GetKey = makeBtn(Card,"🔑  Get Key",178,Color3.fromRGB(88,101,242))
        local Discord = lbl(Card,"discord.gg/PmZhQCnuha",11,216,false,Color3.fromRGB(88,101,242))

        Submit.MouseEnter:Connect(function() Submit.BackgroundColor3 = Color3.fromRGB(240,70,100) end)
        Submit.MouseLeave:Connect(function() Submit.BackgroundColor3 = Color3.fromRGB(220,50,80) end)
        GetKey.MouseEnter:Connect(function() GetKey.BackgroundColor3 = Color3.fromRGB(110,120,255) end)
        GetKey.MouseLeave:Connect(function() GetKey.BackgroundColor3 = Color3.fromRGB(88,101,242) end)

        GetKey.MouseButton1Click:Connect(function()
            pcall(function()
                if typeof(setclipboard) == "function" then setclipboard("https://discord.gg/PmZhQCnuha") end
            end)
            Discord.Text = "✓  Link copied!"; Discord.TextColor3 = Color3.fromRGB(60,220,100)
            task.delay(2.5, function() Discord.Text = "discord.gg/PmZhQCnuha"; Discord.TextColor3 = Color3.fromRGB(88,101,242) end)
        end)

        local function TryKey(input)
            local t = input:match("^%s*(.-)%s*$")
            if t == VALID_KEY then
                verified = true; Status.TextColor3 = Color3.fromRGB(60,220,100)
                Status.Text = "✓  Key accepted — loading..."
                Submit.BackgroundColor3 = Color3.fromRGB(40,180,80); Submit.Text = "✓  Verified"
                SaveKey(t); task.wait(0.9); pcall(function() SG:Destroy() end)
            else
                Status.TextColor3 = Color3.fromRGB(220,60,80); Status.Text = "✗  Invalid key"
                TweenService:Create(Card,TweenInfo.new(0.05,Enum.EasingStyle.Bounce),{Position=UDim2.new(0.5,-196,0.5,-120)}):Play()
                task.wait(0.07)
                TweenService:Create(Card,TweenInfo.new(0.05,Enum.EasingStyle.Bounce),{Position=UDim2.new(0.5,-204,0.5,-120)}):Play()
                task.wait(0.07)
                TweenService:Create(Card,TweenInfo.new(0.08,Enum.EasingStyle.Quad),{Position=UDim2.new(0.5,-200,0.5,-120)}):Play()
            end
        end
        Submit.MouseButton1Click:Connect(function() TryKey(Box.Text) end)
        Box.FocusLost:Connect(function(enter) if enter then TryKey(Box.Text) end end)
        repeat task.wait(0.1) until verified
    end
end

