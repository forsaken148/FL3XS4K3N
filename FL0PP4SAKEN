    ok, mod = pcall(function() return require(ReplicatedStorage.Modules.Minigames.LockBoard) end)
    if ok and mod then LockBoardModule = mod end
    if not LockBoardModule then
        LockBoardModule = select(1, findModuleByName(ReplicatedStorage, "LockBoard"))
    end

    if MinigameFolder then
        local map = {
            FlowInput = function(m) FlowInputModule = m end,
            GearInput = function(m) GearInputModule = m end,
