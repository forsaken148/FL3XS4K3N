local lastK, lastKPos, smoothSpd = nil, nil, 0
RunService.Heartbeat:Connect(function(dt)
    if not BS.AutoStuds then
        lastK = nil; smoothSpd = 0
        return
    end
    local killer = BS_GetFirstKiller()
    if killer then
        local kHrp = killer:FindFirstChild("HumanoidRootPart")
        if kHrp then
            local curPos = kHrp.Position
            local rawSpd = 0
            if lastK == killer and lastKPos then
                local hd = Vector3.new(curPos.X,0,curPos.Z) - Vector3.new(lastKPos.X,0,lastKPos.Z)
                rawSpd = hd.Magnitude / math.max(dt, 1e-4)
            end
            lastK = killer; lastKPos = curPos
            smoothSpd = smoothSpd + (rawSpd - smoothSpd) * math.min(dt*15, 1)
            local fs = math.clamp(smoothSpd, 0, 30)
            local sRun = BS.AutoRunStuds
            if BS.DetectPing then
                local ping = math.max(BS_GetPing(), 20)
                sRun = BS.AutoRunStuds - ((ping - 20) / 100) * 1.5
                sRun = math.max(sRun, 1.0)
            end
            local slope = (BS.AutoStandStuds - sRun) / 26.0
            BS.BehindStuds = BS.AutoStandStuds - (fs * slope)
        else
            lastK = nil
        end
    else
        lastK = nil; smoothSpd = 0
    end
end)

