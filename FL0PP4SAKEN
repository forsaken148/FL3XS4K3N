local _TabSec = {}

local function GetSec(Tab)
    if not _TabSec[Tab] then
        _TabSec[Tab] = Tab:CreateSection("General")
    end
    return _TabSec[Tab]
end

local function AddSection(Tab, Title)
    local sec = Tab:CreateSection(Title)
    _TabSec[Tab] = sec
    return sec
end

local function AddToggle(Tab, Key, Title, Default, Callback)
    return GetSec(Tab):AddToggle(Key, {Text=Title, Default=Default, Callback=Callback})
end

local function AddSlider(Tab, Key, Title, Min, Max, Default, Step, Callback)
    return GetSec(Tab):AddSlider(Key, {Text=Title, Min=Min, Max=Max, Default=Default, Rounding=Step and (Step<1 and 2 or 0) or 0, Callback=Callback})
end

local function AddButton(Tab, Title, Callback)
    return GetSec(Tab):AddButton({Text=Title, Func=Callback})
end

local function AddDropdown(Tab, Key, Title, Values, Default, Callback)
    return GetSec(Tab):AddDropdown(Key, {Text=Title, Values=Values, Default=Default, Callback=Callback})
end

local function AddInput(Tab, Key, Title, Default, Callback)
    return GetSec(Tab):AddInput(Key, {Text=Title, Default=Default, Callback=Callback})
end

