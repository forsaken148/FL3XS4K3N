local function VC_Clear()
    for _, k in ipairs({"tipBall","leftBall","rightBall","leftRay","rightRay","leftArc","rightArc"}) do
        if VC[k] then pcall(function() VC[k]:Destroy() end); VC[k] = nil end
    end
end

local function VC_GetKillerHRP()
    local kf = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild("Killers")
    if not kf then return nil end
    for _, k in ipairs(kf:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        local hum = k:FindFirstChildWhichIsA("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp end
    end
    return nil
end

local function VC_Update()
    if not VC.enabled then
        if VC.tipBall then VC_Clear() end
        return
    end

    local killerHRP = VC_GetKillerHRP()
    if not killerHRP then VC_Clear(); return end

    local lv       = killerHRP.CFrame.LookVector
    local halfAng  = math.rad(VC.angle / 2)
    local perp     = Vector3.new(-lv.Z, 0, lv.X).Unit
    local leftDir  = (lv * math.cos(halfAng) + perp  * math.sin(halfAng)).Unit
    local rightDir = (lv * math.cos(halfAng) - perp  * math.sin(halfAng)).Unit
    local origin   = killerHRP.Position
    local tipPos   = origin + lv        * VC.range
    local leftPos  = origin + leftDir   * VC.range
    local rightPos = origin + rightDir  * VC.range

    if not VC.tipBall   then VC.tipBall   = VC_MakeBall() end
    if not VC.leftBall  then VC.leftBall  = VC_MakeBall() end
    if not VC.rightBall then VC.rightBall = VC_MakeBall() end
    if not VC.leftRay   then VC.leftRay   = VC_MakeBeam() end
    if not VC.rightRay  then VC.rightRay  = VC_MakeBeam() end
    if not VC.leftArc   then VC.leftArc   = VC_MakeBeam() end
    if not VC.rightArc  then VC.rightArc  = VC_MakeBeam() end

    VC.tipBall.Position   = tipPos
    VC.leftBall.Position  = leftPos
    VC.rightBall.Position = rightPos

    VC_PlaceBeam(VC.leftRay,   origin,   leftPos)
    VC_PlaceBeam(VC.rightRay,  origin,   rightPos)
    VC_PlaceBeam(VC.leftArc,   leftPos,  tipPos)
    VC_PlaceBeam(VC.rightArc,  tipPos,   rightPos)
end

local function VC_Start()
    if VC.heartbeat then return end
    VC.heartbeat = RunService.Heartbeat:Connect(VC_Update)
end

local function VC_Stop()
    if VC.heartbeat then VC.heartbeat:Disconnect(); VC.heartbeat = nil end
    VC_Clear()
end

