local function AddSlider(Tab, Key, Title, Min, Max, Default, Step, Callback)
    local Value = Saved[Key]
    if type(Value) ~= "number" then Value = Default end
    if type(Value) == "number" then Value = math.clamp(Value, Min, Max) end
    State[Key] = Value
    local Element
    local function onSlide(New)
        local v = tonumber(type(New) == "table" and (New.Value or New.Default or New[1]) or New)
        if not v then return end
        v = math.clamp(v, Min, Max)
        State[Key] = v
        Saved[Key] = v
        SaveSettings()
        if Callback then task.spawn(SafeCall, Key, Callback, v) end
    end
    local Ok, Err = pcall(function()
        Element = Container(Tab):Slider({
            Title    = tostring(Title),
            Step     = Step or 1,
            Value    = { Min = Min, Max = Max, Default = Value },
            Flag     = Key,
            Callback = onSlide,
        })
    end)
    if not Ok then warn("[FlexSaken] Slider '" .. tostring(Title) .. "' failed: " .. tostring(Err)) end
    Registry[Key] = { Kind = "slider", Title = tostring(Title), Default = Default, Callback = Callback, Element = Element }
    if Callback then task.defer(SafeCall, Key, Callback, Value) end
    return Element
end

