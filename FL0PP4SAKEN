-- JOHN DOE SPIKE AIMBOT
-- ============================================================
local JDSpikeAimbot = {}
do
    -- State (mirrors original: enabled flag, locked target, active highlight)
    local _Enabled  = false
    local _Target   = nil  -- Player instance
    local _Highlight= nil  -- Highlight instance on target's character
    local _HeartbeatConn = nil

    -- Remove any FlexSaken-owned highlight from a player's character
    local function _RemoveHighlight(player)
        if not player then return end
        local char = player.Character
        if not char then return end
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Highlight") and child.Name == "JDSpikeHL" then
                child:Destroy()
            end
        end
    end

    -- Add a red highlight to a player's character, returns the Highlight instance
    local function _AddHighlight(player)
        if not player then return nil end
        local char = player.Character
        if not char then return nil end
        _RemoveHighlight(player)
        local hl = Instance.new("Highlight")
        hl.Name             = "JDSpikeHL"
        hl.Adornee          = char
        hl.FillColor        = Color3.fromRGB(255, 0, 0)
        hl.OutlineColor     = Color3.fromRGB(0, 0, 0)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent           = char
        return hl
    end

    -- Find the nearest enemy player by closest screen-center distance
    -- (targets all Players, matching the source script's intent)
    local function _FindNearest()
        local guiService = game:GetService("GuiService")
        local res = guiService:GetScreenResolution()
        local screenCenter = Vector2.new(res.X / 2, res.Y / 2)
        local camera = workspace.CurrentCamera
        local best, bestDist = nil, math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                        if onScreen then
                            local dist = (screenCenter - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                best = player
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    -- Stop aiming and clean up
    local function _StopAiming()
        if _HeartbeatConn then
            _HeartbeatConn:Disconnect()
            _HeartbeatConn = nil
        end
        if _Target then
            pcall(_RemoveHighlight, _Target)
            _Target = nil
        end
        _Highlight = nil
    end

    -- Start aiming at the nearest target
    local function _StartAiming()
        _StopAiming()
        local target = _FindNearest()
        if not target then return end

        _Target    = target
        _Highlight = _AddHighlight(target)

        -- Heartbeat: rotate camera toward target HRP with velocity prediction
        _HeartbeatConn = RunService.Heartbeat:Connect(function()
            if not _Enabled then _StopAiming(); return end

            local char = _Target and _Target.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                -- Target lost — try to reacquire
                _StopAiming()
                _StartAiming()
                return
            end

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                _StopAiming()
                _StartAiming()
                return
            end

            local cam = workspace.CurrentCamera
            -- Velocity prediction factor matches the source script (0.1768521)
            cam.CFrame = CFrame.new(cam.CFrame.Position, hrp.Position + hrp.Velocity * 0.1768521)
        end)
    end

    -- Public interface for the UI toggle
    function JDSpikeAimbot.SetEnabled(v)
        _Enabled = v
        if v then
            _StartAiming()
        else
            _StopAiming()
        end
    end

    -- Re-acquire target if the locked player's character respawns
    LocalPlayer.CharacterAdded:Connect(function()
        if _Enabled then
            task.wait(1)
            _StartAiming()
        end
    end)
end
