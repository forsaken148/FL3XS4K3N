local X4Aimbot = {}
do
    local x4Active = true

    local x4CONFIG = {
        Enabled                 = false,
        AutoConfigure           = true,
        WallCheck               = false,
        WallClampPredict        = true,
        LockTargetDuringWindup  = true,
        TargetPriority          = "Smart",
        FacingWeight            = 0.35,
        AimSmoothness           = 1,
        Stationary = {
            SpeedThreshold          = 1.6,
            MoveDirThreshold        = 0.08,
            DisplacementThreshold   = 0.18,
            WindowSeconds           = 0.12,
        },
        Prediction = {
            VelocitySmoothing   = 16,
            PingSmoothing       = 10,
            PingFactor          = 0.5,
            MaxPing             = 0.35,
            MaxTargetSpeed      = 120,
            JukeDampening       = 0.45,
            DistanceDampStart   = 55,
            DistanceDampEnd     = 140,
            MinDistanceScale    = 0.72,
        },
        Abilities = {
            MassInfection = {
                Enabled = true, Windup = 1.7, Speed = 104, Lifetime = 6,
                MaxRange = 160, ExtraLead = 0.0, MaxPredictTime = 2.2,
                AnimIds = { ["99050723653468"] = true },
            },
            Entanglement = {
                Enabled = true, Windup = 0.75, Speed = 125, Lifetime = 1,
                MaxRange = 125, ExtraLead = 0.0, MaxPredictTime = 1.4,
                AnimIds = { ["133272604443790"] = true },
            },
        },
    }

    local x4SmoothShiftLock = nil
    pcall(function()
        x4SmoothShiftLock = require(ReplicatedStorage.Systems.Player.Game.SmoothShiftLock)
    end)

    local x4TargetData     = setmetatable({}, { __mode = "k" })
    local x4SmoothedPing   = 0
    local x4ActiveAbility  = nil
    local x4ActiveStart    = 0
    local x4LockedTarget   = nil
    local x4LockedHum      = nil
    local x4SavedAutoRot   = nil
    local x4SavedShiftLock = false
    local x4LastSkin       = nil

    local function x4ExtractAnimIds(value, out)
        if type(value) == "string" or type(value) == "number" then
            local id = tostring(value):match("%d+")
            if id then out[id] = true end
        elseif type(value) == "table" then
            for _, v in pairs(value) do x4ExtractAnimIds(v, out) end
        end
    end

    local function x4ApplyCfgModule(cfg)
        if type(cfg) ~= "table" then return end
        local mass = x4CONFIG.Abilities.MassInfection
        local ent  = x4CONFIG.Abilities.Entanglement
        if type(cfg.MassInfectionShockwaveSpeed) == "number" and cfg.MassInfectionShockwaveSpeed > 0 then mass.Speed = cfg.MassInfectionShockwaveSpeed end
        if type(cfg.MassInfectionShockwaveLifetime) == "number" and cfg.MassInfectionShockwaveLifetime > 0 then mass.Lifetime = cfg.MassInfectionShockwaveLifetime; mass.MaxRange = math.clamp(mass.Speed * mass.Lifetime, 40, 220) end
        if type(cfg.EntanglementSpeed) == "number" and cfg.EntanglementSpeed > 0 then ent.Speed = cfg.EntanglementSpeed end
        if type(cfg.EntanglementLifetime) == "number" and cfg.EntanglementLifetime > 0 then ent.Lifetime = cfg.EntanglementLifetime; ent.MaxRange = math.clamp(ent.Speed * ent.Lifetime, 30, 180) end
        if type(cfg.Animations) == "table" then
            if cfg.Animations.MassInfection then x4ExtractAnimIds(cfg.Animations.MassInfection, mass.AnimIds) end
            if cfg.Animations.Entanglement  then x4ExtractAnimIds(cfg.Animations.Entanglement,  ent.AnimIds)  end
        end
    end

    local function x4AutoConfigure(char)
        if not x4CONFIG.AutoConfigure then return end
        local skinName = char and (char:GetAttribute("SkinName") or "") or ""
        if x4LastSkin == skinName then return end
        x4LastSkin = skinName
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        if not assets then return end
        local baseKiller = assets:FindFirstChild("Killers") and assets.Killers:FindFirstChild("1x1x1x1")
        if baseKiller and baseKiller:FindFirstChild("Config") then
            local ok, cfg = pcall(require, baseKiller.Config)
            if ok then x4ApplyCfgModule(cfg) end
        end
        if skinName ~= "" then
            local skins = assets:FindFirstChild("Skins")
            local killerSkins = skins and skins:FindFirstChild("Killers") and skins.Killers:FindFirstChild("1x1x1x1")
            local skinFolder = killerSkins and killerSkins:FindFirstChild(skinName)
            if skinFolder and skinFolder:FindFirstChild("Config") then
                local ok, skinCfg = pcall(require, skinFolder.Config)
                if ok then x4ApplyCfgModule(skinCfg) end
            end
        end
    end

    local function x4GetSurvivors()
        local f = workspace:FindFirstChild("Players")
        return f and f:FindFirstChild("Survivors")
    end

    local function x4IsKiller(char)
        if not char or not char.Parent then return false end
        return (char:GetAttribute("CharacterName") or char.Name) == "1x1x1x1"
    end

    local function x4BuildRayParams()
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        p.IgnoreWater = true
        p.RespectCanCollide = true
        local pf = workspace:FindFirstChild("Players")
        p.FilterDescendantsInstances = pf and { pf } or { LocalPlayer.Character }
        return p
    end

    local function x4HasLOS(origin, targetModel, targetRoot)
        local dir = targetRoot.Position - origin
        if dir.Magnitude < 0.05 then return true end
        local hit = workspace:Raycast(origin, dir, x4BuildRayParams())
        return not hit or hit.Instance:IsDescendantOf(targetModel)
    end

    local function x4ClampToWall(startPos, predictedPos)
        if not x4CONFIG.WallClampPredict then return predictedPos end
        local dir = predictedPos - startPos
        if dir.Magnitude < 0.2 then return predictedPos end
        local hit = workspace:Raycast(startPos, dir, x4BuildRayParams())
        if hit then return startPos + dir.Unit * math.max(0, (hit.Position - startPos).Magnitude - 1.5) end
        return predictedPos
    end

    local function x4UpdateTracking(dt)
        local rawPing = 0
        pcall(function() rawPing = math.clamp(LocalPlayer:GetNetworkPing(), 0, x4CONFIG.Prediction.MaxPing) end)
        local pingAlpha = 1 - math.exp(-x4CONFIG.Prediction.PingSmoothing * math.max(dt, 0.001))
        x4SmoothedPing = x4SmoothedPing == 0 and rawPing or (x4SmoothedPing + (rawPing - x4SmoothedPing) * pingAlpha)
        local survivors = x4GetSurvivors()
        if not survivors then return end
        local now = os.clock()
        local velAlpha = 1 - math.exp(-x4CONFIG.Prediction.VelocitySmoothing * math.max(dt, 0.001))
        local statCfg = x4CONFIG.Stationary
        for _, model in ipairs(survivors:GetChildren()) do
            local root = model:FindFirstChild("HumanoidRootPart")
            local hum  = model:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local pos   = root.Position
                local entry = x4TargetData[model]
                if not entry or entry.Root ~= root then
                    x4TargetData[model] = { Root=root, LastPos=pos, AnchorPos=pos, AnchorTime=now, Velocity=Vector3.zero, LastDir=Vector3.zero, JukeFactor=0, IsStationary=true }
                else
                    local rawVel = dt > 0 and ((pos - entry.LastPos) / dt) or Vector3.zero
                    rawVel = Vector3.new(rawVel.X, 0, rawVel.Z)
                    if dt > 0.25 or rawVel.Magnitude > x4CONFIG.Prediction.MaxTargetSpeed then entry.Velocity = Vector3.zero
                    else entry.Velocity = entry.Velocity:Lerp(rawVel, velAlpha) end
                    local flatVel = entry.Velocity
                    local speed   = flatVel.Magnitude
                    if speed > 1 then
                        local dir = flatVel.Unit
                        if entry.LastDir.Magnitude > 0.5 then
                            local turn = math.clamp(1 - entry.LastDir:Dot(dir), 0, 2) * 0.5
                            entry.JukeFactor = entry.JukeFactor + (turn - entry.JukeFactor) * velAlpha
                        end
                        entry.LastDir = dir
                    else entry.JukeFactor = entry.JukeFactor * (1 - velAlpha) end
                    if now - entry.AnchorTime >= statCfg.WindowSeconds then
                        local disp    = Vector3.new(pos.X - entry.AnchorPos.X, 0, pos.Z - entry.AnchorPos.Z).Magnitude
                        local moveMag = hum.MoveDirection.Magnitude
                        entry.IsStationary = (speed < statCfg.SpeedThreshold) and (moveMag < statCfg.MoveDirThreshold) and (disp < statCfg.DisplacementThreshold)
                        entry.AnchorPos = pos; entry.AnchorTime = now
                    elseif hum.MoveDirection.Magnitude < statCfg.MoveDirThreshold and speed < statCfg.SpeedThreshold * 0.6 then entry.IsStationary = true
                    elseif speed > statCfg.SpeedThreshold * 1.5 then entry.IsStationary = false end
                    entry.LastPos = pos
                end
            end
        end
    end

    local function x4SolveIntercept(relPos, targetVel, projSpeed)
        if projSpeed <= 0 then return 0 end
        local a = targetVel:Dot(targetVel) - projSpeed * projSpeed
        local b = 2 * relPos:Dot(targetVel)
        local c = relPos:Dot(relPos)
        if c < 0.0001 then return 0 end
        if math.abs(a) < 0.0001 then
            if math.abs(b) > 0.0001 then local t = -c / b; if t >= 0 then return t end end
            return relPos.Magnitude / projSpeed
        end
        local disc = b*b - 4*a*c
        if disc < 0 then return relPos.Magnitude / projSpeed end
        local sq = math.sqrt(disc)
        local t1, t2 = (-b - sq) / (2*a), (-b + sq) / (2*a)
        local best = math.huge
        if t1 >= 0 and t1 < best then best = t1 end
        if t2 >= 0 and t2 < best then best = t2 end
        return best < math.huge and best or (relPos.Magnitude / projSpeed)
    end

    local function x4IsValidTarget(model, myPos, maxRange)
        if not model or not model.Parent or model == LocalPlayer.Character then return nil end
        local root = model:FindFirstChild("HumanoidRootPart")
        local hum  = model:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return nil end
        if (root.Position - myPos).Magnitude > maxRange then return nil end
        if x4CONFIG.WallCheck and not x4HasLOS(myPos, model, root) then return nil end
        return root
    end

    local function x4SelectTarget(myRoot, maxRange)
        local survivors = x4GetSurvivors()
        if not survivors then return nil, nil end
        local myPos = myRoot.Position
        local look  = Vector3.new(myRoot.CFrame.LookVector.X, 0, myRoot.CFrame.LookVector.Z)
        look = look.Magnitude > 0.001 and look.Unit or Vector3.new(0,0,-1)
        local bestModel, bestRoot, bestScore = nil, nil, math.huge
        for _, model in ipairs(survivors:GetChildren()) do
            local root = x4IsValidTarget(model, myPos, maxRange)
            if root then
                local delta = Vector3.new(root.Position.X - myPos.X, 0, root.Position.Z - myPos.Z)
                local dist  = delta.Magnitude
                local score = dist
                if x4CONFIG.TargetPriority == "Smart" and dist > 0.1 then
                    local alignPenalty = (1 - math.clamp(look:Dot(delta.Unit), -1, 1)) * 0.5
                    score = dist * (1 + alignPenalty * x4CONFIG.FacingWeight)
                end
                if score < bestScore then bestScore = score; bestModel = model; bestRoot = root end
            end
        end
        return bestModel, bestRoot
    end

    local function x4GetRemainingWindup(char, abilityCfg)
        local hum = char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.IsPlaying and track.Animation then
                    local id = tostring(track.Animation.AnimationId):match("%d+")
                    if id and abilityCfg.AnimIds[id] then
                        local speed = math.abs(track.Speed)
                        if speed < 0.001 then speed = 1 end
                        return math.max(0, abilityCfg.Windup - (track.TimePosition / speed))
                    end
                end
            end
        end
        return math.max(0, abilityCfg.Windup - (os.clock() - x4ActiveStart))
    end

    local function x4ComputePredict(myPos, targetModel, targetRoot, remainingWindup, abilityCfg)
        local entry = x4TargetData[targetModel]
        if entry and entry.IsStationary then return targetRoot.Position end
        local targetVel = entry and entry.Velocity or Vector3.new(targetRoot.AssemblyLinearVelocity.X, 0, targetRoot.AssemblyLinearVelocity.Z)
        if targetVel.Magnitude < x4CONFIG.Stationary.SpeedThreshold or targetVel.Magnitude > x4CONFIG.Prediction.MaxTargetSpeed then return targetRoot.Position end
        local predCfg = x4CONFIG.Prediction
        local dist = (targetRoot.Position - myPos).Magnitude
        local distScale = 1
        if dist > predCfg.DistanceDampStart then
            local t = math.clamp((dist - predCfg.DistanceDampStart) / math.max(1, predCfg.DistanceDampEnd - predCfg.DistanceDampStart), 0, 1)
            distScale = 1 - t * (1 - predCfg.MinDistanceScale)
        end
        local jukeScale  = 1 - math.clamp((entry and entry.JukeFactor or 0) * predCfg.JukeDampening, 0, 0.45)
        local effectiveVel = targetVel * (distScale * jukeScale)
        local preDelay   = remainingWindup + (x4SmoothedPing * predCfg.PingFactor) + abilityCfg.ExtraLead
        local futurePos  = targetRoot.Position + effectiveVel * preDelay
        local relPos     = Vector3.new(futurePos.X - myPos.X, 0, futurePos.Z - myPos.Z)
        local flightTime = x4SolveIntercept(relPos, effectiveVel, abilityCfg.Speed)
        local totalLead  = math.clamp(preDelay + flightTime, 0, abilityCfg.MaxPredictTime)
        return x4ClampToWall(targetRoot.Position, targetRoot.Position + effectiveVel * totalLead)
    end

    local function x4RestoreControl()
        if x4LockedHum and x4LockedHum.Parent and x4SavedAutoRot ~= nil then x4LockedHum.AutoRotate = x4SavedAutoRot end
        x4LockedHum = nil; x4SavedAutoRot = nil
        if x4SavedShiftLock and x4SmoothShiftLock and not x4SmoothShiftLock.Enabled then
            pcall(function() x4SmoothShiftLock:ToggleShiftLock() end)
        end
        x4SavedShiftLock = false
    end

    local function x4ResetActive()
        x4ActiveAbility = nil; x4LockedTarget = nil
        x4RestoreControl()
    end

    local function x4DetectAbility(char)
        local mults = char:FindFirstChild("SpeedMultipliers")
        if not mults then return nil end
        if x4CONFIG.Abilities.MassInfection.Enabled and mults:FindFirstChild("MassInfection") then return "MassInfection" end
        if x4CONFIG.Abilities.Entanglement.Enabled  and mults:FindFirstChild("Entanglement")  then return "Entanglement"  end
        return nil
    end

    RunService.Heartbeat:Connect(function(dt)
        if not x4CONFIG.Enabled or not x4Active then return end
        x4UpdateTracking(dt)
    end)

    RunService:BindToRenderStep("X4BodyAimbotV2", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not x4CONFIG.Enabled or not x4Active then
            if x4ActiveAbility then x4ResetActive() end
            return
        end
        local char = LocalPlayer.Character
        if not x4IsKiller(char) then if x4ActiveAbility then x4ResetActive() end; return end
        x4AutoConfigure(char)
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 or root.Anchored then if x4ActiveAbility then x4ResetActive() end; return end
        local current = x4DetectAbility(char)
        if not current then if x4ActiveAbility then x4ResetActive() end; return end
        local abilityCfg = x4CONFIG.Abilities[current]
        if current ~= x4ActiveAbility then x4ActiveAbility = current; x4ActiveStart = os.clock(); x4LockedTarget = nil end
        local remainingWindup = x4GetRemainingWindup(char, abilityCfg)
        if remainingWindup <= 0 then x4RestoreControl(); return end
        local targetModel, targetRoot = nil, nil
        if x4CONFIG.LockTargetDuringWindup and x4LockedTarget then
            targetRoot = x4IsValidTarget(x4LockedTarget, root.Position, abilityCfg.MaxRange)
            if targetRoot then targetModel = x4LockedTarget else x4LockedTarget = nil end
        end
        if not targetModel then
            targetModel, targetRoot = x4SelectTarget(root, abilityCfg.MaxRange)
            if x4CONFIG.LockTargetDuringWindup then x4LockedTarget = targetModel end
        end
        if not targetModel or not targetRoot then x4RestoreControl(); return end
        local aimPos  = x4ComputePredict(root.Position, targetModel, targetRoot, remainingWindup, abilityCfg)
        local flatAim = Vector3.new(aimPos.X, root.Position.Y, aimPos.Z)
        if (flatAim - root.Position).Magnitude < 0.05 then return end
        if x4LockedHum ~= hum then
            x4RestoreControl(); x4LockedHum = hum; x4SavedAutoRot = hum.AutoRotate; hum.AutoRotate = false
            if x4SmoothShiftLock and x4SmoothShiftLock.Enabled then
                x4SavedShiftLock = true; pcall(function() x4SmoothShiftLock:ToggleShiftLock() end)
            end
        end
        local targetCFrame = CFrame.lookAt(root.Position, flatAim)
        if x4CONFIG.AimSmoothness >= 1 then root.CFrame = targetCFrame
        else
            local alpha = 1 - (1 - math.clamp(x4CONFIG.AimSmoothness, 0.01, 1)) ^ (math.max(dt, 0.001) * 60)
            root.CFrame = CFrame.new(root.Position) * root.CFrame.Rotation:Lerp(targetCFrame.Rotation, alpha)
        end
    end)

    X4Aimbot.config = x4CONFIG
end

