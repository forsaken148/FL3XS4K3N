do
    local AI_Config = {
        Enabled          = false,
        VisibleThreshold = 0.05,
        EffectPatterns   = { "invisib", "undetect" },
    }

    local AI_Tracked     = {}
    local AI_Connections = {}

    local function AI_IsVisual(inst)
        if inst:FindFirstAncestorOfClass("Tool") then return false end
        return inst:IsA("BasePart") or inst:IsA("Decal") or inst:IsA("Texture")
    end

    local function AI_IsFace(inst)
        if not (inst:IsA("Decal") or inst:IsA("Texture")) then return false end
        local p = inst.Parent
        return (p and p:IsA("BasePart") and p.Name:lower() == "head")
            or inst.Name:lower():find("face", 1, true) ~= nil
    end

    local function AI_MatchesEffect(name)
        local low = name:lower()
        for _, pat in ipairs(AI_Config.EffectPatterns) do
            if low:find(pat, 1, true) then return true end
        end
        return false
    end

    local function AI_HasEffect(character)
        local function CheckAttrs(inst)
            for name, value in pairs(inst:GetAttributes()) do
                if AI_MatchesEffect(name) then
                    if value == true or (typeof(value) == "number" and value > 0) then return true end
                end
            end
            return false
        end
        if CheckAttrs(character) then return true end
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum and CheckAttrs(hum) then return true end
        for _, desc in ipairs(character:GetDescendants()) do
            if AI_MatchesEffect(desc.Name) then
                if desc:IsA("BoolValue") then
                    if desc.Value then return true end
                elseif desc:IsA("NumberValue") or desc:IsA("IntValue") then
                    if desc.Value > 0 then return true end
                else
                    return true
                end
            end
        end
        return false
    end

    local function AI_IsInvisible(data)
        local vis, invis = 0, 0
        for inst, transparency in pairs(data.Baseline) do
            if inst.Parent and not data.Ignored[inst] and inst:IsA("BasePart") and transparency < 0.95 then
                vis += 1
                if inst.Transparency > transparency + AI_Config.VisibleThreshold
                    or inst.LocalTransparencyModifier > AI_Config.VisibleThreshold
                then invis += 1 end
            end
        end
        return vis > 0 and invis / vis >= 0.5
    end

    local function AI_Untrack(char)
        local data = AI_Tracked[char]
        if not data then return end
        for _, c in ipairs(data.Connections) do c:Disconnect() end
        table.clear(data.Connections); table.clear(data.Visuals)
        table.clear(data.Baseline);   table.clear(data.Ignored)
        AI_Tracked[char] = nil
    end

    local function AI_Track(char)
        if AI_Tracked[char] or char == LocalPlayer.Character then return end
        local data = { Visuals = {}, Baseline = {}, Ignored = {}, HasBaseline = false, Connections = {} }
        for _, desc in ipairs(char:GetDescendants()) do
            if AI_IsVisual(desc) then data.Visuals[desc] = true end
        end
        table.insert(data.Connections, char.DescendantAdded:Connect(function(desc)
            if not AI_IsVisual(desc) then return end
            if data.HasBaseline
                and not desc:IsA("Accessory")
                and desc:FindFirstAncestorOfClass("Accessory") == nil
                and not AI_IsFace(desc)
            then data.Ignored[desc] = true; return end
            data.Visuals[desc] = true
        end))
        table.insert(data.Connections, char.DescendantRemoving:Connect(function(desc)
            data.Visuals[desc] = nil; data.Baseline[desc] = nil; data.Ignored[desc] = nil
        end))
        table.insert(data.Connections, char.AncestryChanged:Connect(function(_, parent)
            if not parent then AI_Untrack(char) end
        end))
        AI_Tracked[char] = data
    end

    local function AI_HookPlayer(player)
        if player == LocalPlayer then return end
        if player.Character then AI_Track(player.Character) end
        table.insert(AI_Connections, player.CharacterAdded:Connect(AI_Track))
        table.insert(AI_Connections, player.CharacterRemoving:Connect(AI_Untrack))
    end

    local AI_Loop = nil

    local function AI_Start()
        for _, player in ipairs(Players:GetPlayers()) do AI_HookPlayer(player) end
        table.insert(AI_Connections, Players.PlayerAdded:Connect(AI_HookPlayer))

        AI_Loop = RunService.RenderStepped:Connect(function()
            if not AI_Config.Enabled then return end
            for char, data in pairs(AI_Tracked) do
                if not char.Parent then AI_Untrack(char); continue end
                local effectOn  = AI_HasEffect(char)
                local invisible = effectOn or (data.HasBaseline and AI_IsInvisible(data))
                if not invisible then
                    for inst in pairs(data.Visuals) do
                        if inst.Parent and not data.Ignored[inst] then
                            local cur  = inst.Transparency
                            local prev = data.Baseline[inst]
                            if prev ~= nil and not AI_IsFace(inst) and math.abs(cur - prev) > 0.25 then
                                data.Ignored[inst]  = true
                                data.Baseline[inst] = nil
                                data.Visuals[inst]  = nil
                            else
                                data.Baseline[inst] = cur
                            end
                        end
                    end
                    data.HasBaseline = true
                elseif data.HasBaseline then
                    for inst, transparency in pairs(data.Baseline) do
                        if inst.Parent and not data.Ignored[inst] and transparency < 0.95 then
                            if inst.Transparency > transparency then inst.Transparency = transparency end
                            if inst:IsA("BasePart") and inst.LocalTransparencyModifier ~= 0 then
                                inst.LocalTransparencyModifier = 0
                            end
                        end
                    end
                end
            end
        end)
    end

    local function AI_Stop()
        if AI_Loop then AI_Loop:Disconnect(); AI_Loop = nil end
        for _, c in ipairs(AI_Connections) do c:Disconnect() end
        table.clear(AI_Connections)
        for char in pairs(AI_Tracked) do AI_Untrack(char) end
    end

    AddSection(TabExtra, "Anti-Invisible")
    AddToggle(TabExtra, "AntiInvisible", "Enable Anti-Invisible", false, function(on)
        AI_Config.Enabled = on
        if on then AI_Start() else AI_Stop() end
        Notify("Anti-Invisible", on and "Active — revealing hidden players" or "Disabled", 3)
    end)
    AddSlider(TabExtra, "AI_Threshold", "Visible Threshold", 0.01, 0.5, 0.05, 0.01, function(v)
        AI_Config.VisibleThreshold = v
    end)
end

