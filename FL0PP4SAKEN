-- ============================================================
-- DEVICE SPOOF (full implementation)
-- ============================================================
local DS = {
    Running = false,
    Token   = 0,
    Device  = "Console",
    Network = nil,
}

do
    local function DSGetNetwork()
        if DS.Network then return DS.Network end
        local ok, mod = pcall(function()
            return require(ReplicatedStorage.Modules.Network.Network)
        end)
        if ok and mod then DS.Network = mod end
        return DS.Network
    end

    local function DSFire()
        if not DS.Running then return end
        local net = DSGetNetwork()
        if not net then return end
        pcall(function()
            net:FireServerConnection("SetDevice", "REMOTE_EVENT", DS.Device)
        end)
    end

    local function DSStart()
        DS.Token += 1
        local tok = DS.Token
        DSFire()
        UserInputService.LastInputTypeChanged:Connect(function()
            if DS.Running then pcall(DSFire) end
        end)
        task.spawn(function()
            while DS.Running and tok == DS.Token do
                pcall(DSFire)
                task.wait(1)
            end
        end)
    end

    local function DSStop()
        DS.Running = false
        DS.Token  += 1
    end

    local TabDevice = Window:CreateTab("Device Spoof")

    AddSection(TabDevice, "Device Spoof")
    AddToggle(TabDevice, "DeviceSpoofEnabled", "Enable Device Spoof", false, function(on)
        DS.Running = on
        if on then DSStart() else DSStop() end
        KanhaUI:Notify({
            Title   = "Device Spoof",
            Content = on and ("Spoofing as " .. DS.Device) or "Stopped",
            Duration = 3,
        })
    end)
    AddDropdown(TabDevice, "DeviceSpoofTarget", "Target Device", { "Console", "Mobile", "PC" }, "Console", function(v)
        DS.Device = v
        if DS.Running then
            KanhaUI:Notify({ Title = "Device Spoof", Content = "Switched to " .. v, Duration = 2 })
        end
    end)
    AddButton(TabDevice, "Fire Once", function()
        local net = DS.Network or (function()
            local ok, mod = pcall(function()
                return require(ReplicatedStorage.Modules.Network.Network)
            end)
            return ok and mod or nil
        end)()
        if net then
            pcall(function() net:FireServerConnection("SetDevice", "REMOTE_EVENT", DS.Device) end)
        end
        KanhaUI:Notify({ Title = "Device Spoof", Content = "Fired SetDevice → " .. DS.Device, Duration = 2 })
    end)
    AddSection(TabDevice, "Info")
    local infoSec = _TabSec[TabDevice]
    infoSec:AddLabel("Spoofer fires every second while enabled and also on input type change. Requires the game's Network module at ReplicatedStorage.Modules.Network.Network.")
end
